# Ensures the sdist (.tar.gz) contains everything needed to actually
# rebuild the package from source — not just what setuptools happens to
# include by default. Confirmed via a real sdist build that, without
# this file, LICENSE, pyproject.toml, and _core.pyx (the actual Cython
# source, as opposed to _core.c which is just its generated output)
# were all missing from the resulting archive.
include LICENSE
include pyproject.toml
include dynamic_font/_core.pyx
recursive-include dynamic_font *.c *.h
# Third-party license texts (also shipped inside the wheel)
recursive-include dynamic_font/licenses *
# HarfBuzz and SheenBidi sources, compiled into the extension (see setup.py)
graft harfbuzz_src
graft sheenbidi_src
# CMake project CI uses to prebuild HarfBuzz + SheenBidi (setup.py falls back
# to compiling their sources when the libraries are absent, as in an sdist)
include hbsb/CMakeLists.txt
